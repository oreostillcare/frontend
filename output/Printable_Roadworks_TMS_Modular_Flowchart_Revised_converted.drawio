.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Node becomes RED and pulses&lt;br&gt;Show top warning and current location/time/date&lt;br&gt;Notify N and P" vertex="1"><mxGeometry height="125" width="380" x="615" y="1710" as="geometry"/></mxCell><mxCell id="m-15" parent="m-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="No warning&lt;br&gt;Keep synchronized node state for Administrator and Operator" vertex="1"><mxGeometry height="105" width="350" x="250" y="1540" as="geometry"/></mxCell><mxCell id="m-16" parent="m-1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#16A34A;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#0F172A;align=center;verticalAlign=middle;" value="END / Monitor" vertex="1"><mxGeometry height="70" width="210" x="695" y="1970" as="geometry"/></mxCell>
