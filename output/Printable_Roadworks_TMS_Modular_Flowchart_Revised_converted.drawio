    <mxCell id="n-3" parent="n-1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#16A34A;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#0F172A;align=center;verticalAlign=middle;" value="N START" vertex="1"><mxGeometry height="70" width="180" x="710" y="160" as="geometry"/></mxCell><mxCell id="n-4" parent="n-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Begin new session&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Reset Node A and Node B lifecycle for this session&lt;/font&gt;" vertex="1"><mxGeometry height="105" width="340" x="630" y="290" as="geometry"/></mxCell><mxCell id="n-5" parent="n-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Confirm Node A origin&lt;br&gt;Location, date, and time" vertex="1"><mxGeometry height="95" width="300" x="250" y="470" as="geometry"/></mxCell><mxCell id="n-6" parent="n-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Confirm Node B origin&lt;br&gt;Location, date, and time" vertex="1"><mxGeometry height="95" width="300" x="1050" y="470" as="geometry"/></mxCell><mxCell id="n-7" parent="n-1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Both origins confirmed?" vertex="1"><mxGeometry height="100" width="230" x="685" y="680" as="geometry"/></mxCell><mxCell id="n-8" parent="n-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Create ACTIVE session log&lt;br&gt;Node A and Node B are GREEN/active" vertex="1"><mxGeometry height="105" width="340" x="630" y="880" as="geometry"/></mxCell><mxCell id="n-9" parent="n-1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Alarm triggered?" vertex="1"><mxGeometry height="100" width="210" x="695" y="1080" as="geometry"/></mxCell><mxCell id="n-10" parent="n-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Write COMPROMISED event&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Current location, date, time, node, warning actor&lt;/font&gt;" vertex="1"><mxGeometry height="110" width="360" x="625" y="1270" as="geometry"/></mxCell><mxCell id="n-11" parent="n-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Wait for retrieval action&lt;br&gt;Administrator or Operator may retrieve" vertex="1"><mxGeometry height="100" width="330" x="630" y="1490" as="geometry"/></mxCell><mxCell id="n-12" parent="n-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Write RETRIEVED event&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Retrieved location, date, time, node, user/action&lt;/font&gt;" vertex="1"><mxGeometry height="110" width="360" x="625" y="1690" as="geometry"/></mxCell><mxCell id="n-13" parent="n-1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Both nodes retrieved?" vertex="1"><mxGeometry height