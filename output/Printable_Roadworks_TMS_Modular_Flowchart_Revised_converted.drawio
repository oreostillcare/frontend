  <diagram id="module-n-session-logs" name="N - Node Session Logs"><mxGraphModel dx="2672" dy="1258" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2540" math="0" shadow="0"><root>
