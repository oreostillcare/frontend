  <diagram id="module-k-traffic-decision" name="K - Traffic Decision and Signals"><mxGraphModel dx="2672" dy="1258" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2540" math="0" shadow="0"><root>
    <mxCell id="k-0"/><mxCell id="k-1" parent="k-0"/><mxCell id="k-2" parent="k-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=24;fontColor=#0F172A;align=left;verticalAlign=middle;" value="&lt;b&gt;MODULE K - Traffic Decision and Signals&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Select weighted or timer control, then issue a safe Node A/Node B signal sequence.&lt;/font&gt;" vertex="1"><mxGeometry height="80" width="1450" x="50" y="40" as="geometry"/></mxCell>
    <mxCell id="k-3" parent="k-1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#16A34A;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#0F172A;align=center;verticalAlign=middle;" value="K START" vertex="1"><mxGeometry height="70" width="180" x="710" y="160" as="geometry"/></mxCell><mxCell id="k-4" parent="k-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Receive current traffic snapshot&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Node A/B counts, classes, signal state, green/red lane positions&lt;/font&gt;" vertex="1"><mxGeometry height="105" width="360" x="620" y="290" as="geometry"/></mxCell><mxCell id="k-5" parent="k-1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Vehicles behind green lane?" vertex="1"><mxGeometry height="105" width="250" x="675" y="470" as="geometry"/></mxCell><mxCell id="k-6" parent="k-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Weighted decision&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Class points only between green and red&lt;br&gt;Compare Node A and Node B points&lt;/font&gt;" vertex="1"><mxGeometry height="115" width="350" x="250" y="700" as="geometry"/></mxCell><mxCell id="k-7" parent="k-1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;" value="&lt;b&gt;L&lt;/b&gt;" vertex="1"><mxGeometry height="80" width="80" x="1030" y="720" as="geometry"/></mxCell><mxCell id="k-8" parent="k-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#475569;align=left;verticalAlign=middle;" value="Timer batching&lt;br&gt;60-second admission window" vertex="1"><mxGeometry height="70" width="230" x="1125" y="730" as="geometry"/></mxCell><mxCell id="k-9" parent="k-1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Controller reachable?" vertex="1"><mxGeometry height="100" width="230" x="685" y="940" as="geometry"/></mxCell><mxCell id="k-10" parent="k-1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;" value="&lt;b&gt;I&lt;/b&gt;" vertex="1"><mxGeometry height="80" width="80" x="350" y="950" as="geometry"/></mxCell><mxCell id="k-11" parent="k-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#475569;align=left;verticalAlign=middle;" value="Offline / connectivity handler&lt;br&gt;Keep safe state and retry" vertex="1"><mxGeometry height="70" width="280" x="250" y="1050" as="geometry"/></mxCell><mxCell id="k-12" parent="k-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="traffic_control.py&lt;br&gt;Both RED safety interlock&lt;br&gt;Selected node GREEN" vertex="1"><mxGeometry height="115" width="330" x="635" y="1170" as="geometry"/></mxCell><mxCell id="k-13" parent="k-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Transition&lt;br&gt;Current node GREEN → YELLOW → RED&lt;br&gt;Next node becomes GREEN" vertex="1"><mxGeometry height="115" width="350" x="625" y="1400" as="geometry"/></mxCell><mxCell id="k-14" parent="k-1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ECFDF3;