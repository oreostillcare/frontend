EdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#E2E8F0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="k-e9" edge="1" parent="k-1" source="k-12" target="k-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#E2E8F0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="k-e10" edge="1" parent="k-1" source="k-13" target="k-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#E2E8F0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="k-note" parent="k-1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=12;fontColor=#475569;align=left;verticalAlign=middle;spacing=10;" value="Decision rule: choose weighted mode when vehicles are only between green and red. Choose timer mode when vehicles are also behind the green line." vertex="1"><mxGeometry height="75" width="1450" x="50" y="1800" as="geometry"/></mxCell>
