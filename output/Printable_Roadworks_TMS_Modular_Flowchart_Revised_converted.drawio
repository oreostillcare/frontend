  <diagram id="module-l-timer-batching" name="L - Timer Batching"><mxGraphModel dx="2672" dy="1258" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2540" math="0" shadow="0"><root>
    <mxCell id="l-0"/><mxCell id="l-1" parent="l-0"/><mxCell id="l-2" parent="l-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=24;fontColor=#0F172A;align=left;verticalAlign=middle;" value="&lt;b&gt;MODULE L - Timer Batching&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Admit vehicles for 60 seconds, stop after inactivity, reconcile counts, and hand off to O.&lt;/font&gt;" vertex="1"><mxGeometry height="80" width="1450" x="50" y="40" as="geometry"/></mxCell>
    <mxCell id="l-3" parent="l-1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#16A34A;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#0F172A;align=center;verticalAlign=middle;" value="L START" vertex="1"><mxGeometry height="70" width="180" x="710" y="160" as="geometry"/></mxCell><mxCell id="l-4" parent="l-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Start 60-second admission window&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Weighted comparison is bypassed&lt;/font&gt;" vertex="1"><mxGeometry height="105" width="330" x="635" y="290" as="geometry"/></mxCell><mxCell id="l-5" parent="l-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Detect vehicles continuously&lt;br&gt;Increment incoming and outgoing counts&lt;br&gt;Record class, date, time, and node in memory" vertex="1"><mxGeometry height="120" width="360" x="620" y="470" as="geometry"/></mxCell><mxCell id="l-6" parent="l-1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="New vehicle detected?" vertex="1"><mxGeometry height="100" width="220" x="685" y="680" as="geometry"/></mxCell><mxCell id="l-7" parent="l-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Increment entered/exited count&lt;br&gt;Reset inactivity timer" vertex="1"><mxGeometry height="90" width="280" x="260" y="870" as="geometry"/></mxCell><mxCell id="l-8" parent="l-1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="60s expired or 15s idle?" vertex="1"><mxGeometry height="105" width="240" x="675" y="870" as="geometry"/></mxCell><mxCell id="l-9" parent="l-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Continue timer and counting" vertex="1"><mxGeometry height="80" width="240" x="1020" y="870" as="geometry"/></mxCell><mxCell id="l-10" parent="l-1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Entered = exited?" vertex="1"><mxGeometry height="105" width="230" x="680" y="1110" as="geometry"/></mxCell><mxCell id="l-11" parent="l-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Keep draining current batch&lt;br&gt;Wait for outgoing detections" vertex="1"><mxGeometry height="90" width="270" x="1030" y="1140" as="geometry"/></mxCell><mxCell id="l-12" parent="l-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Close admission&lt;br&gt;YELLOW for 2 seconds, then RED&lt;br&gt;Next node becomes GREEN" vertex="1"><mxGeometry height="120" width="350" x="620" y="1360" as="geometry"/></mxCell><mxCell id="l-13" parent="l-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#16A34A;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=8;" value="Completed timer batch&lt;br&gt;Send reconciled payload to O" vertex="1"><mxGeometry height="100" width="330" x="630" y="1580" as="geometry"/></mxCell><mxCell id="l-14" parent="l-1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#16A34A;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#0F172A;align=center;verticalAlign=middle;" value="END → O" vertex="1"><mxGeometry height="70" width="190" x="700" y="1770" as="geometry"/></mxCell>
