  <diagram id="legend" name="Module Legend and Routing"><mxGraphModel page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="SmartRoad — Complete Modular Flowchart" style="text;html=1;fontSize=24;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="30" width="800" height="40" as="geometry"/></mxCell><mxCell id="n" value="One page per module. Ellipse=start/end, rectangle=process, diamond=decision, cylinder=Firebase/API. Solid arrows=normal flow; dashed arrows=error/offline/future. Secrets stay in .env." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1"><mxGeometry x="40" y="85" width="1450" height="55" as="geometry"/></mxCell><mxCell id="s" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="70" y="220" width="120" height="60" as="geometry"/></mxCell><mxCell id="a" value="A Auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="250" y="220" width="140" height="60" as="geometry"/></mxCell><mxCell id="r" value="Role?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="450" y="210" width="130" height="80" as="geometry"/></mxCell><mxCell id="ui" value="B–G, J UI modules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="650" y="220" width="180" height="60" as="geometry"/></mxCell><mxCell id="k" value="K–L Traffic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="900" y="220" width="170" height="60" as="geometry"/></mxCell><mxCell id="mn" value="M–N Node lifecycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cdebff;strokeColor=#5b9bd5" vertex="1" parent="1"><mxGeometry x="1140" y="220" width="190" height="60" as="geomet