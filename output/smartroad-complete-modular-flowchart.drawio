  <diagram id="routes" name="Routes and Data Contracts"><mxGraphModel page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="SmartRoad — Routes, APIs, Backend and Firebase Contracts" style="text;html=1;fontSize=22;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="40" as="geometry"/></mxCell><mxCell id="web" value="Next.js routes&#xa;/login • /dashboard • /dashboard/monitoring&#xa;/dashboard/analytics • /dashboard/logs&#xa;/dashboard/staff • /dashboard/account" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="50" y="150" width="300" height="170" as="geometry"/></mxCell><mxCell id="api" value="Shared APIs&#xa;/api/traffic/transactions&#xa;/api/node-states&#xa;/api/node-session-logs&#xa;ID token + role guard" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="460" y="150" width="280" height="180" as="geometry"/></mxCell><mxCell id="back" value="Backend&#xa;app.py, camera.py, detector.py&#xa;tracking.py, traffic_control.py&#xa;timer_batches.py" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="850" y="150" width="280" height="170" as="geometry"/></mxCell><mxCell id="db" value="Firestore&#xa;staff • trafficEvents • trafficTransactions&#xa;systemEvents • nodeStates • nodeSessionLogs" style="cylinder;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#cdebff;strokeColor=#5b9bd5" vertex="1" parent="1"><mxGeometry x="1240" y="150" width="300" height="170" as="geometry"/></mxCell><mxCell id="e1" edge="1" parent="1" source="web" target="api" style="edgeStyle=orthogonalEdgeStyle;endArrow=block"/><mxCell id="e2" edge="1" parent="1" source="api" target="back" style="edgeStyle=orthogonalEdgeStyle;end