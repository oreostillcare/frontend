<mxfile host="app.diagrams.net" modified="2026-10-14T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="smartroad-four-data-structures" name="Four Data Structures">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="SmartRoad Database Structure — Four Core Data Domains" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Firebase Authentication is a separate identity service. Users, vehicle records, and system/error logs are stored as Cloud Firestore collections." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1520" height="50" as="geometry" />
        </mxCell>

        <mxCell id="auth-box" value="1. AUTHENTICATION&#xa;Firebase Authentication" style="swimlane;html=1;rounded=1;startSize=55;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="350" height="440" as="geometry" />
        </mxCell>
        <mxCell id="auth-fields" value="User account&#xa;&#xa;uid : string [PRIMARY KEY]&#xa;email : string&#xa;passwordCredential : managed by Firebase&#xa;displayName : string&#xa;emailVerified : boolean&#xa;disabled : boolean&#xa;createdAt : managed timestamp&#xa;lastSignInAt : managed timestamp&#xa;&#xa;Purpose&#xa;• Sign in and identity verification&#xa;• Password and email security&#xa;• Produces ID token for API requests" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#eaf3ff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="auth-box">
          <mxGeometry x="25" y="80" width="300" height="325" as="geometry" />
        </mxCell>

        <mxCell id="users-box" value="2. USERS&#xa;Firestore: staff" style="swimlane;html=1;rounded=1;startSize=55;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="430" y="160" width="350" height="440" as="geometry" />
        </mxCell>
        <mxCell id="users-fields" value="staff/{uid}&#xa;&#xa;uid : string [PRIMARY KEY, AUTH FK]&#xa;authUid : string [legacy UID link]&#xa;username : string&#xa;email : string&#xa;normalizedEmail : string&#xa;role : Administrator | Operator&#xa;emailVerified : boolean&#xa;accountStatus : active | archived&#xa;status : string&#xa;emailChangeStatus : none | pending | completed&#xa;dateJoined : timestamp&#xa;createdAt : timestamp&#xa;updatedAt : timestamp&#xa;invitedBy : uid" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#e9f5e8;strokeColor=#82b366;fontSize=13;" vertex="1" parent="users-box">
          <mxGeometry x="25" y="80" width="300" height="325" as="geometry" />
        </mxCell>

        <mxCell id="vehicles-box" value="3. SASAKYAN / VEHICLES&#xa;Firestore: trafficEvents + trafficTransactions" style="swimlane;html=1;rounded=1;startSize=55;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="820" y="160" width="350" height="750" as="geometry" />
        </mxCell>
        <mxCell id="vehicle-event-fields" value="trafficEvents/{eventId}&#xa;&#xa;eventId : transactionId_vehicleId [PRIMARY KEY]&#xa;vehicleId : string&#xa;vehicleClass : string&#xa;nodeId : node-a | node-b&#xa;laneId : lane-a | lane-b&#xa;cameraId : number&#xa;confidence : number | null&#xa;direction : string&#xa;eventType : vehicle_passed&#xa;occurredAt : timestamp&#xa;points : number&#xa;transactionId : string [TRANSACTION FK]&#xa;sessionId : string&#xa;sourceTrackId : number | null&#xa;destinationTrackId : number | null&#xa;sourceDetectedAt : timestamp | null&#xa;destinationConfirmedAt : timestamp&#xa;redTouchedAt : timestamp" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fff8df;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="vehicles-box">
          <mxGeometry x="20" y="75" width="310" height="365" as="geometry" />
        </mxCell>
        <mxCell id="transaction-fields" value="trafficTransactions/{transactionId}&#xa;&#xa;transactionId : string [PRIMARY KEY]&#xa;sourceNode : node-a | node-b&#xa;destinationNode : node-a | node-b&#xa;batchTotal : number&#xa;batchPoints : number&#xa;releasedVehicles : Vehicle[]&#xa;status : complete&#xa;createdAt : timestamp&#xa;greenStartedAt : timestamp&#xa;sourceCompletedAt : timestamp&#xa;completedAt : timestamp&#xa;storedAt : timestamp&#xa;schemaVersion : number" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fff8df;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="vehicles-box">
          <mxGeometry x="20" y="470" width="310" height="240" as="geometry" />
        </mxCell>

        <mxCell id="logs-box" value="4. ERROR / SYSTEM LOGS&#xa;Firestore: systemEvents" style="swimlane;html=1;rounded=1;startSize=55;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1210" y="160" width="350" height="440" as="geometry" />
        </mxCell>
        <mxCell id="logs-fields" value="systemEvents/{eventId}&#xa;&#xa;eventId : string [PRIMARY KEY]&#xa;occurredAt : timestamp&#xa;eventType : string&#xa;category : string&#xa;component : string&#xa;severity : info | warning | critical&#xa;message : string&#xa;eventStatus : active | observed | resolved&#xa;nodeId : string&#xa;laneId : string [optional]&#xa;vehicleCount : number [optional]&#xa;signal : GREEN | RED | UNKNOWN [optional]&#xa;powerSource : string [optional]&#xa;batteryPercent : number [optional]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#fdebea;strokeColor=#b85450;fontSize=13;" vertex="1" parent="logs-box">
          <mxGeometry x="25" y="80" width="300" height="325" as="geometry" />
        </mxCell>

        <mxCell id="access-box" value="Access rule summary&#xa;&#xa;1. User signs in through Firebase Authentication.&#xa;2. The ID token UID must match an active staff/{uid} document.&#xa;3. Active staff can read trafficEvents and systemEvents.&#xa;4. Browser writes are denied; trusted server APIs use Firebase Admin SDK." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="740" height="190" as="geometry" />
        </mxCell>

        <mxCell id="auth-users-edge" value="1 : 1&#xa;uid links identity to profile" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=12;fontStyle=1;" edge="1" parent="1" source="auth-fields" target="users-fields">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="users-vehicles-edge" value="Authorized staff reads analytics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#6c8ebf;fontSize=12;" edge="1" parent="1" source="users-fields" target="vehicle-event-fields">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="users-logs-edge" value="Authorized staff reads logs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85450;fontSize=12;" edge="1" parent="1" source="users-fields" target="logs-fields">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="transaction-events-edge" value="1 transaction contains many vehicle events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;fontSize=12;" edge="1" parent="1" source="transaction-fields" target="vehicle-event-fields">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vehicle-logs-edge" value="Optional node/lane/vehicle-count context" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#b85450;fontSize=12;" edge="1" parent="1" source="vehicle-event-fields" target="logs-fields">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
