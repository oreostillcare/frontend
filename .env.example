# Firebase web application
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Firebase Admin (use these in hosted environments)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Explicit safety acknowledgement required by the online Firebase smoke test.
# The test only creates and cleans up uniquely prefixed temporary records.
FIREBASE_LIVE_TEST_ALLOW_WRITES=false

# Public SmartRoad origin used in verification-email continuation links
APP_BASE_URL=http://localhost:3000

# At least 16 random characters; configure the same value in Vercel
CRON_SECRET=
# Optional dedicated secret for Python traffic transaction ingestion. When blank,
# both services fall back to CRON_SECRET.
TRAFFIC_INGEST_SECRET=

# Used only by the Next.js server. Browser clients use the same-origin /detection proxy.
DETECTION_BACKEND_URL=http://127.0.0.1:5000
# Python detection backend -> Flow 1 ESP32 traffic-light control.
LOGI_C270_CAMERA_INDEX=2
WEB_CAMERA_INDEX=1
CAMERA_CAPTURE_FPS=60
ENABLE_ESP32_POINT_CONTROL=true
GUIDE_GREEN_Y_PERCENT=15
GUIDE_RED_Y_PERCENT=80
DIRECTION_MOTION_DEADBAND_PIXELS=4
DIRECTION_MOTION_WINDOW_FRAMES=5
DIRECTION_REVERSAL_MIN_DISTANCE_PIXELS=24
OUTGOING_ROUTE_COMPLETION_PERCENT=50
ESP32_NODE_A_IP=192.168.1.220
ESP32_NODE_B_IP=192.168.1.221
ESP32_TIMEOUT_SECONDS=1.25
ESP32_REQUEST_ATTEMPTS=2
TRAFFIC_COMPARISON_INTERVAL_SECONDS=1
# Keep disabled during camera/traffic-light testing.
ENABLE_TRAFFIC_FIRESTORE_UPLOAD=false
TRAFFIC_OUTGOING_CONFIRMATION_FRAMES=3
TRAFFIC_OUTGOING_CONFIRMATION_SECONDS=1.0
TRAFFIC_OUTGOING_ID_SWITCH_GRACE_SECONDS=1.0
TRAFFIC_FIRESTORE_URL=http://127.0.0.1:3000/api/traffic/transactions
TRAFFIC_FIRESTORE_TIMEOUT_SECONDS=5
# Comma-separated hostnames/IPs used to open the development dashboard from other devices.
DASHBOARD_ALLOWED_DEV_ORIGINS=192.168.0.103
