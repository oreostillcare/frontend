DV20_USB_CAMERA_INDEX=0
LOGI_C270_CAMERA_INDEX=2
WEB_CAMERA_INDEX=1

# RTSP - FOR FUTURE USE
CAMERA_1_RTSP_URL="rtsp://username:password@camera-ip:554/stream1"
CAMERA_2_RTSP_URL=""
LOCAL_YOLO_MODEL="models/trained_local.pt"
COCO_YOLO_MODEL="models/yolov8n.pt"
DETECTION_CONFIDENCE=0.35
DETECTION_IMAGE_SIZE=640
CAMERA_CAPTURE_FPS=60
DETECTION_FPS=5
ENABLE_LINE_COUNTING=true
LINE_X1=0
LINE_Y1=360
LINE_X2=1280
LINE_Y2=360
# Shared horizontal camera-guide positions used for direction and crossing logic.
GUIDE_GREEN_Y_PERCENT=15
GUIDE_RED_Y_PERCENT=80
DIRECTION_MOTION_DEADBAND_PIXELS=4
DIRECTION_MOTION_WINDOW_FRAMES=5
DIRECTION_REVERSAL_MIN_DISTANCE_PIXELS=24
OUTGOING_ROUTE_COMPLETION_PERCENT=50
# Optional per-camera overrides; leave blank to use the shared values above.
CAMERA_1_GUIDE_GREEN_Y_PERCENT=
CAMERA_1_GUIDE_RED_Y_PERCENT=
CAMERA_2_GUIDE_GREEN_Y_PERCENT=
CAMERA_2_GUIDE_RED_Y_PERCENT=
# Session-wide vehicle-ID reassociation tuning.
GLOBAL_ID_LOCAL_GRACE_SECONDS=6
GLOBAL_ID_CROSS_CAMERA_SECONDS=60
GLOBAL_ID_MATCH_THRESHOLD=0.55
GLOBAL_ID_AMBIGUITY_MARGIN=0.08
GLOBAL_ID_MIN_SAMPLE_CONFIDENCE=0.45
GLOBAL_ID_MAX_SAMPLES=8
# Automatic point comparison and existing Flow 1 ESP32 addresses.
ENABLE_ESP32_POINT_CONTROL=true
ESP32_NODE_A_IP=192.168.1.220
ESP32_NODE_B_IP=192.168.1.221
ESP32_TIMEOUT_SECONDS=1.25
ESP32_REQUEST_ATTEMPTS=2
ESP32_HEARTBEAT_ENABLED=true
ESP32_HEARTBEAT_INTERVAL_SECONDS=2
ESP32_HEARTBEAT_TIMEOUT_SECONDS=5
TRAFFIC_COMPARISON_INTERVAL_SECONDS=1
# Keep disabled during camera/traffic-light testing.
ENABLE_TRAFFIC_FIRESTORE_UPLOAD=false
TRAFFIC_OUTGOING_CONFIRMATION_FRAMES=3
TRAFFIC_OUTGOING_CONFIRMATION_SECONDS=1.0
TRAFFIC_OUTGOING_ID_SWITCH_GRACE_SECONDS=1.0
# Must match TRAFFIC_INGEST_SECRET (or CRON_SECRET) in the Next.js .env.
TRAFFIC_INGEST_SECRET=
TRAFFIC_FIRESTORE_URL=http://127.0.0.1:3000/api/traffic/transactions
TRAFFIC_FIRESTORE_TIMEOUT_SECONDS=5
FRONTEND_ORIGIN="http://localhost:3000,http://192.168.1.6:3000,http://192.168.1.12:3000,http://192.168.56.1:3000,http://192.168.105.114:3000"
CAMERA_RECONNECT_SECONDS=3
ROBOFLOW_ETRIKE_EBIKE_DATASET_URL=
ROBOFLOW_ROAD_VEHICLES_DATASET_URL=
